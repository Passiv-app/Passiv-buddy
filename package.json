{
  "name": "passiv-desktop",
  "productName": "Passiv",
  "version": "0.3.3",
  "description": "The Passiv desktop buddy: a movable Passiv icon on top of every app, sticky notes for what it says, hold-to-talk from anywhere, and your to-dos on the front of the screen.",
  "main": "src/main.js",
  "author": "Passiv Solutions LLC",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "cross-env PASSIV_DEV=1 electron .",
    "check": "node --check src/main.js && node --check src/preload-app.js && node --check src/preload-overlay.js && node --check src/preload-ask.js",
    "build": "electron-builder --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.passiv.desktop",
    "productName": "Passiv",
    "copyright": "Copyright \u00a9 2026 Passiv Solutions LLC",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "artifactName": "Passiv-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Passiv listens while you hold the talk keys, so you can talk to it from any app."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "Passiv-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "Passiv-Windows-Setup.${ext}"
    },
    "dmg": {
      "artifactName": "Passiv-mac-${arch}.${ext}",
      "title": "Passiv",
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "asar": true
  }
}